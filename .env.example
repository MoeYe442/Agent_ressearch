# PowerShell: set these with $env:NAME='value'. No automatic .env loading.
REPOLENS_WORKSPACE=D:\code
REPOLENS_DATA=D:\code\Agent\.data
REPOLENS_MODEL_URL=https://your-provider.example/v1
REPOLENS_MODEL=your-tool-calling-model
REPOLENS_API_KEY=replace-locally-never-commit
# Optional: public-repository read rate limit only; never sent to codeload.
REPOLENS_GITHUB_TOKEN=
# Optional hybrid retrieval. Set locally in the process environment; .env is not loaded.
# Keep unset for keyword-only use. Do not reuse a chat key without checking its service.
REPOLENS_MILVUS_URL=
REPOLENS_MILVUS_TOKEN=
REPOLENS_MILVUS_COLLECTION=repolens_chunks_v1
REPOLENS_EMBEDDING_URL=
REPOLENS_EMBEDDING_MODEL=
REPOLENS_EMBEDDING_KEY=
REPOLENS_EMBEDDING_DIMENSIONS=768
REPOLENS_RERANK_URL=
REPOLENS_RERANK_MODEL=
REPOLENS_RERANK_KEY=
