# PowerShell: set these with $env:NAME='value'. No automatic .env loading.
REPOLENS_WORKSPACE=D:\code
REPOLENS_DATA=D:\code\Agent\.data
REPOLENS_MODEL_URL=https://your-provider.example/v1
REPOLENS_MODEL=your-tool-calling-model
REPOLENS_API_KEY=replace-locally-never-commit
# Optional: public-repository read rate limit only; never sent to codeload.
REPOLENS_GITHUB_TOKEN=
