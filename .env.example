# PowerShell: set these with $env:NAME='value'. No automatic .env loading.
REPOLENS_WORKSPACE=D:\code
REPOLENS_DATA=D:\code\Agent\.data
REPOLENS_MODEL_URL=https://your-provider.example/v1
REPOLENS_MODEL=your-tool-calling-model
REPOLENS_API_KEY=replace-locally-never-commit
# Optional: public-repository read rate limit only; never sent to codeload.
REPOLENS_GITHUB_TOKEN=
# Optional hybrid retrieval. Set locally in the process environment; .env is not loaded.
# Keep unset for keyword-only use. Do not reuse a chat key without checking its service.
REPOLENS_MILVUS_URL=
REPOLENS_MILVUS_TOKEN=
REPOLENS_MILVUS_COLLECTION=repolens_chunks_v1
REPOLENS_EMBEDDING_URL=
REPOLENS_EMBEDDING_MODEL=
REPOLENS_EMBEDDING_KEY=
REPOLENS_EMBEDDING_DIMENSIONS=768
REPOLENS_RERANK_URL=
REPOLENS_RERANK_MODEL=
REPOLENS_RERANK_KEY=
# Optional native split mode. Keep embedded for the original SQLite launch.
REPOLENS_EXECUTION_MODE=embedded
REPOLENS_DATABASE_URL=
REPOLENS_REDIS_URL=
REPOLENS_REDIS_QUEUE=repolens:wake
REPOLENS_CLIENT_NETWORKS=127.0.0.0/8,::1/128
# Docker Compose reads .env; the Python process itself still does not.
# Set a strong local password before docker compose up; never commit .env.
POSTGRES_PASSWORD=
# Container workspace source (host directory), loopback port, private bridge subnet.
REPOLENS_REPOSITORIES=D:\code
REPOLENS_PORT=8000
REPOLENS_NETWORK_SUBNET=172.29.37.0/24
# Historical SQLite data directory, only used by the explicit migration profile.
REPOLENS_MIGRATION_DIR=./.data
# Web collection is disabled by default. Exact HTTPS hostnames, no wildcards.
REPOLENS_DOCUMENT_HOSTS=
# Optional Linux-only isolated renderer Unix socket. Compose sets this automatically.
REPOLENS_RENDERER_SOCKET=
